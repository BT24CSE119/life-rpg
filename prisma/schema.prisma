generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A registered user account
model User {
  id               String            @id @default(cuid())
  email            String            @unique
  username         String            @unique
  passwordHash     String?
  googleId         String?           @unique
  avatarUrl        String?
  role             UserRole          @default(USER)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  activityLogs     ActivityLog[]
  character        Character?
  inventory        Inventory[]
  completions      QuestCompletion[]
  quests           Quest[]
  playerProfile    PlayerProfile?
  xpTransactions   XpTransaction[]
  goldTransactions GoldTransaction[]
  refreshTokens    RefreshToken[]
  dailyQuests      DailyQuest[]
  userAchievements UserAchievement[]
  notifications    Notification[]

  @@index([email])
  @@index([username])
  @@index([googleId])
  @@map("users")
}

/// The RPG character associated with a user (1:1)
model Character {
  id              String   @id @default(cuid())
  userId          String   @unique
  name            String
  avatarUrl       String?
  bio             String?
  level           Int      @default(1)
  xp              Int      @default(0)
  gold            Int      @default(100)
  hp              Int      @default(100)
  maxHp           Int      @default(100)
  strength        Int      @default(5)
  agility         Int      @default(5)
  intelligence    Int      @default(5)
  wisdom          Int      @default(5)
  vitality        Int      @default(5)
  charisma        Int      @default(5)
  totalXpEarned   Int      @default(0)
  totalGoldEarned Int      @default(0)
  questsCompleted Int      @default(0)
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastActiveAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("characters")
}

/// A quest/task that a user creates and completes
model Quest {
  id               String            @id @default(cuid())
  userId           String
  title            String
  description      String?
  category         String?
  tags             String[]
  difficulty       QuestDifficulty   @default(MEDIUM)
  priority         QuestPriority     @default(MEDIUM)
  xpReward         Int               @default(50)
  goldReward       Int               @default(25)
  status           QuestStatus       @default(TODO)
  dueDate          DateTime?
  completedAt      DateTime?
  failedAt         DateTime?
  isRecurring      Boolean           @default(false)
  recurrenceRule   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  completions      QuestCompletion[]
  xpTransactions   XpTransaction[]
  goldTransactions GoldTransaction[]
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, priority])
  @@index([userId, dueDate])
  @@map("quests")
}

/// Authoritative Phase 4 progression state for a user.
model PlayerProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  totalXp            Int      @default(0)
  level              Int      @default(1)
  goldBalance        Int      @default(0)
  strength           Int      @default(1)
  intelligence       Int      @default(1)
  discipline         Int      @default(1)
  stamina            Int      @default(1)
  consistency        Int      @default(1)
  currentStreak      Int      @default(0)
  longestStreak      Int      @default(0)
  lastProductiveDate String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("player_profiles")
}

/// Immutable ledger of every server-authorized Gold balance change.
model GoldTransaction {
  id           String              @id @default(cuid())
  userId       String
  questId      String?             @unique
  amount       Int
  balanceAfter Int
  type         GoldTransactionType
  reason       GoldReason
  createdAt    DateTime            @default(now())
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest        Quest?              @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("gold_transactions")
}

/// Immutable ledger entry for XP granted by a trusted server-side action.
model XpTransaction {
  id        String   @id @default(cuid())
  userId    String
  questId   String?  @unique
  amount    Int
  reason    XpReason
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest     Quest?   @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("xp_transactions")
}

/// A log entry when a quest is completed
model QuestCompletion {
  id          String   @id @default(cuid())
  questId     String
  userId      String
  completedAt DateTime @default(now())
  xpEarned    Int
  goldEarned  Int
  notes       String?
  quest       Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questId])
  @@index([userId, completedAt])
  @@map("quest_completions")
}

/// Daily Missions generated once per day per user
model DailyQuest {
  id          String          @id @default(cuid())
  userId      String
  code        String
  title       String
  description String?
  difficulty  QuestDifficulty @default(MEDIUM)
  xpReward    Int             @default(30)
  goldReward  Int             @default(15)
  status      QuestStatus     @default(TODO)
  date        String // Format: YYYY-MM-DD
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, code])
  @@index([userId])
  @@index([userId, date])
  @@index([userId, status])
  @@map("daily_quests")
}

/// System-defined achievements that can be earned
model Achievement {
  id               String            @id @default(cuid())
  code             String            @unique
  title            String
  description      String
  category         String            @default("GENERAL")
  rarity           ItemRarity        @default(COMMON)
  xpReward         Int               @default(50)
  goldReward       Int               @default(25)
  iconEmoji        String            @default("🏆")
  badgeUrl         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  userAchievements UserAchievement[]

  @@map("achievements")
}

/// Achievements unlocked by a user
model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@map("user_achievements")
}

/// Real-time user notification
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// A shop item that can be purchased with Gold
model Item {
  id          String      @id @default(cuid())
  name        String      @unique
  description String
  type        ItemType
  rarity      ItemRarity  @default(COMMON)
  category    String?
  xpBonus     Int         @default(0)
  goldBonus   Int         @default(0)
  hpBonus     Int         @default(0)
  strBonus    Int         @default(0)
  agiBonus    Int         @default(0)
  intBonus    Int         @default(0)
  wisBonus    Int         @default(0)
  vitBonus    Int         @default(0)
  chaBonus    Int         @default(0)
  goldCost    Int
  isActive    Boolean     @default(true)
  imageUrl    String?
  iconEmoji   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  inventory   Inventory[]

  @@index([type])
  @@index([rarity])
  @@index([isActive])
  @@map("items")
}

/// An item in a user's inventory
model Inventory {
  id         String   @id @default(cuid())
  userId     String
  itemId     String
  quantity   Int      @default(1)
  isEquipped Boolean  @default(false)
  acquiredAt DateTime @default(now())
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
  @@index([userId, isEquipped])
  @@map("inventory")
}

/// An audit log of all significant actions taken by a user
model ActivityLog {
  id        String    @id @default(cuid())
  userId    String
  action    LogAction
  metadata  Json?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, action])
  @@index([userId, createdAt])
  @@map("activity_logs")
}

/// Stored refresh token (hashed) for session management
model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique // SHA-256 hash of the raw token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

enum UserRole {
  USER
  ADMIN
}

enum QuestPriority {
  LOW
  MEDIUM
  HIGH
}

enum QuestDifficulty {
  TRIVIAL
  EASY
  MEDIUM
  HARD
  EPIC
  LEGENDARY
}

enum QuestStatus {
  TODO
  IN_PROGRESS
  ACTIVE
  COMPLETED
  FAILED
  ABANDONED
}

enum XpReason {
  QUEST_COMPLETION
  DAILY_QUEST_COMPLETION
  ACHIEVEMENT_UNLOCKED
}

enum GoldTransactionType {
  QUEST_REWARD
  BONUS
  PENALTY
  ADMIN_ADJUSTMENT
  PURCHASE
  REFUND
}

enum GoldReason {
  QUEST_COMPLETION
  DAILY_QUEST_COMPLETION
  ACHIEVEMENT_UNLOCKED
  BONUS
  SHOP_PURCHASE
}

enum NotificationType {
  LEVEL_UP
  ACHIEVEMENT_UNLOCKED
  QUEST_COMPLETED
  DAILY_QUEST
  STREAK_MILESTONE
  SHOP_PURCHASE
  SYSTEM
}

enum ItemType {
  WEAPON
  ARMOR
  ACCESSORY
  CONSUMABLE
  COSMETIC
  BOOST
}

enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum LogAction {
  QUEST_CREATED
  QUEST_COMPLETED
  DAILY_QUEST_COMPLETED
  QUEST_FAILED
  QUEST_ABANDONED
  LEVEL_UP
  ITEM_PURCHASED
  ITEM_EQUIPPED
  ITEM_UNEQUIPPED
  STREAK_MILESTONE
  ACHIEVEMENT_UNLOCKED
  CHARACTER_CREATED
  ATTRIBUTE_INCREASED
}
