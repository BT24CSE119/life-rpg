generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A registered user account
model User {
  id             String            @id @default(cuid())
  email          String            @unique
  username       String            @unique
  passwordHash   String
  role           UserRole          @default(USER)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  activityLogs   ActivityLog[]
  character      Character?
  inventory      Inventory[]
  completions    QuestCompletion[]
  quests         Quest[]
  playerProfile  PlayerProfile?
  xpTransactions XpTransaction[]
  refreshTokens  RefreshToken[]

  @@index([email])
  @@index([username])
  @@map("users")
}

/// The RPG character associated with a user (1:1)
model Character {
  id              String   @id @default(cuid())
  userId          String   @unique
  name            String
  avatarUrl       String?
  bio             String?
  level           Int      @default(1)
  xp              Int      @default(0)
  gold            Int      @default(100)
  hp              Int      @default(100)
  maxHp           Int      @default(100)
  strength        Int      @default(5)
  agility         Int      @default(5)
  intelligence    Int      @default(5)
  wisdom          Int      @default(5)
  vitality        Int      @default(5)
  charisma        Int      @default(5)
  totalXpEarned   Int      @default(0)
  totalGoldEarned Int      @default(0)
  questsCompleted Int      @default(0)
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastActiveAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("characters")
}

/// A quest/task that a user creates and completes
model Quest {
  id             String            @id @default(cuid())
  userId         String
  title          String
  description    String?
  category       String?
  tags           String[]
  difficulty     QuestDifficulty   @default(MEDIUM)
  priority       QuestPriority     @default(MEDIUM)
  xpReward       Int               @default(50)
  goldReward     Int               @default(25)
  status         QuestStatus       @default(TODO)
  dueDate        DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  isRecurring    Boolean           @default(false)
  recurrenceRule String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  completions    QuestCompletion[]
  xpTransactions XpTransaction[]
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, priority])
  @@index([userId, dueDate])
  @@map("quests")
}

/// Authoritative Phase 4 progression state for a user.
model PlayerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  totalXp      Int      @default(0)
  level        Int      @default(1)
  strength     Int      @default(1)
  intelligence Int      @default(1)
  discipline   Int      @default(1)
  stamina      Int      @default(1)
  consistency  Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("player_profiles")
}

/// Immutable ledger entry for XP granted by a trusted server-side action.
model XpTransaction {
  id        String   @id @default(cuid())
  userId    String
  questId   String   @unique
  amount    Int
  reason    XpReason
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest     Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("xp_transactions")
}

/// A log entry when a quest is completed
model QuestCompletion {
  id          String   @id @default(cuid())
  questId     String
  userId      String
  completedAt DateTime @default(now())
  xpEarned    Int
  goldEarned  Int
  notes       String?
  quest       Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questId])
  @@index([userId, completedAt])
  @@map("quest_completions")
}

/// A shop item that can be purchased with Gold
model Item {
  id          String      @id @default(cuid())
  name        String      @unique
  description String
  type        ItemType
  rarity      ItemRarity  @default(COMMON)
  xpBonus     Int         @default(0)
  goldBonus   Int         @default(0)
  hpBonus     Int         @default(0)
  strBonus    Int         @default(0)
  agiBonus    Int         @default(0)
  intBonus    Int         @default(0)
  wisBonus    Int         @default(0)
  vitBonus    Int         @default(0)
  chaBonus    Int         @default(0)
  goldCost    Int
  isActive    Boolean     @default(true)
  imageUrl    String?
  iconEmoji   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  inventory   Inventory[]

  @@index([type])
  @@index([rarity])
  @@map("items")
}

/// An item in a user's inventory
model Inventory {
  id         String   @id @default(cuid())
  userId     String
  itemId     String
  quantity   Int      @default(1)
  isEquipped Boolean  @default(false)
  acquiredAt DateTime @default(now())
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
  @@map("inventory")
}

/// An audit log of all significant actions taken by a user
model ActivityLog {
  id        String    @id @default(cuid())
  userId    String
  action    LogAction
  metadata  Json?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, action])
  @@index([userId, createdAt])
  @@map("activity_logs")
}

/// Stored refresh token (hashed) for session management
model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique // SHA-256 hash of the raw token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

enum UserRole {
  USER
  ADMIN
}

enum QuestPriority {
  LOW
  MEDIUM
  HIGH
}

enum QuestDifficulty {
  TRIVIAL
  EASY
  MEDIUM
  HARD
  EPIC
  LEGENDARY
}

enum QuestStatus {
  TODO
  IN_PROGRESS
  ACTIVE
  COMPLETED
  FAILED
  ABANDONED
}

enum XpReason {
  QUEST_COMPLETION
}

enum ItemType {
  WEAPON
  ARMOR
  ACCESSORY
  CONSUMABLE
  COSMETIC
  BOOST
}

enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum LogAction {
  QUEST_CREATED
  QUEST_COMPLETED
  QUEST_FAILED
  QUEST_ABANDONED
  LEVEL_UP
  ITEM_PURCHASED
  STREAK_MILESTONE
  CHARACTER_CREATED
  ATTRIBUTE_INCREASED
}
