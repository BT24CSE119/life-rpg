# ==================================================
# Life RPG — Environment Variables Template
# ==================================================
# Copy this file to .env and fill in your values.
# NEVER commit real .env files with secrets to version control.
# ==================================================

# --- Database ---
# PostgreSQL connection string (supports Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://postgres:password@localhost:5432/life_rpg?schema=public"
# Direct URL for Prisma migrations if using pooled connections (e.g., Neon / Supabase)
DIRECT_URL="postgresql://postgres:password@localhost:5432/life_rpg?schema=public"

# --- Backend Server ---
PORT=3001
NODE_ENV=development

# --- CORS & Client URLs ---
FRONTEND_URL="http://localhost:5173"

# --- JWT Secrets (generate with: openssl rand -hex 64) ---
JWT_ACCESS_SECRET="your-64-char-random-hex-access-secret"
JWT_REFRESH_SECRET="your-64-char-random-hex-refresh-secret"
JWT_ACCESS_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="90d"

# --- Google OAuth 2.0 (Optional / Integration) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# --- Frontend Environment (.env in frontend/) ---
VITE_API_URL="http://localhost:3001/api"
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
